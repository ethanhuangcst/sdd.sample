# 按项目复制所需变量到该工程 .env.local；密钥真值在仓库根的 .secrets。两者都不提交。
# 对话与图像共用 QUANZIL_API_KEY。不要设置 OPENAI_API_KEY 或 OPENAI_BASE_URL。

QUANZIL_API_KEY=
QUANZIL_BASE_URL=https://quanzil.com/v1
QUANZIL_CHAT_MODEL=gpt-6.1-sol
QUANZIL_IMAGE_MODEL=gemini-3.1-flash-lite-image
QUANZIL_IMAGE_URL=https://quanzil.com/v1beta/models/gemini-3.1-flash-lite-image:generateContent

# 高德地图，搜索中国大陆内的位置用（与百度二选一，按项目需求）。
AMAP_API_KEY=
AMAP_HOST=https://restapi.amap.com
# 地理编码 GET {AMAP_HOST}/v3/geocode/geo?address={地址}&key={KEY}，HTTP 200 且 status=1、infocode=10000 成功。
# 周边检索 GET {AMAP_HOST}/v5/place/around?location={经度},{纬度}&radius={米}&types=050000&key={KEY}。
# 步行路线 GET {AMAP_HOST}/v5/direction/walking?origin={经度},{纬度}&destination={经度},{纬度}&key={KEY}。
# 坐标为 GCJ-02、顺序经度,纬度；发 Open-Meteo 前本地换算 WGS-84。

# 百度地图，搜索中国大陆内的位置用（与高德二选一，按项目需求）。
BAIDUMAP_API_KEY=
BAIDUMAP_GEOCODING_URL=https://api.map.baidu.com/geocoding/v3/
BAIDUMAP_REVERSE_GEOCODING_URL=https://api.map.baidu.com/reverse_geocoding/v3/
BAIDUMAP_PLACE_SEARCH_URL=https://api.map.baidu.com/place/v2/search
BAIDUMAP_PLACE_DETAIL_URL=https://api.map.baidu.com/place/v2/detail
BAIDUMAP_WALKING_DIRECTIONS_URL=https://api.map.baidu.com/directionlite/v1/walking
BAIDUMAP_COORD_CONVERT_URL=https://api.map.baidu.com/geoconv/v1/
BAIDUMAP_RET_COORDTYPE=gcj02ll
# 地理编码 GET {GEOCODING_URL}?address={地址}&output=json&ak={KEY}，status=0 成功，可加 city 过滤。
# 地点检索周边 GET {PLACE_SEARCH_URL}?query={关键词}&location={纬度},{经度}&radius={米}&scope=2&page_size=20&output=json&ak={KEY}&ret_coordtype={RET_COORDTYPE}；按城市检索用 region={城市}&city_limit=true。
# POI 详情 GET {PLACE_DETAIL_URL}?uid={uid}&scope=2&output=json&ak={KEY}。
# 步行路线 GET {WALKING_DIRECTIONS_URL}?origin={纬度},{经度}&destination={纬度},{经度}&ak={KEY}。
# 坐标转换 GET {COORD_CONVERT_URL}?coords={经度},{纬度}&from=1&to=5&ak={KEY}；from 1=WGS-84 3=GCJ-02，to 3=GCJ-02 5=BD-09。百度不输出 WGS-84（转 WGS-84 返回 status=4）。
# 百度默认返回 BD-09 坐标；ret_coordtype=gcj02ll 返回国测局坐标。百度链路与 Google、天气的 WGS-84 相差约百米级，混用前先统一坐标类型。
# Key 只在服务端使用，禁止 NEXT_PUBLIC_*。

# 搜索中国大陆外的位置用 Google Maps。
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODE_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_MAPS_DIRECTIONS_URL=https://maps.googleapis.com/maps/api/directions/json
GOOGLE_MAPS_PLACES_SEARCH_NEARBY_URL=https://places.googleapis.com/v1/places:searchNearby
GOOGLE_MAPS_PLACES_SEARCH_TEXT_URL=https://places.googleapis.com/v1/places:searchText
GOOGLE_MAPS_PLACES_PHOTO_PREFIX=https://places.googleapis.com/v1
GOOGLE_MAPS_FIELD_MASK=places.displayName,places.formattedAddress,places.location,places.photos

# 天气不需要 Key。坐标为 WGS-84。
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# 星座不需要 Key。
PANDORIUM_MCP_URL=https://pandorium.app/mcp

# 宝可梦 TCG 目录不需要 Key。
TCGDEX_BASE_URL=https://api.tcgdex.net/v2

# 菜谱 MCP：三个来源都无需 Key。
RECIPEWIKI_MCP_URL=https://www.recipewiki.com/api/mcp
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
